# Copy this file to .env. Never commit real keys.
# Chat_Safe works with NONE of these set — it falls back to the offline rules engine.

# --- Google Gemini (AI answers in 23 languages) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SAFE_BROWSING_API_KEY=
GOOGLE_MAPS_API_KEY=
PORT=8080
NODE_ENV=production

# --- Security, CORS, Encryption & Admin Audit ---
ALLOWED_ORIGIN=
FORCE_HTTPS=false
DATA_ENCRYPTION_KEY=
ADMIN_API_KEY=
MAX_CONCURRENT_REQUESTS=200
DB_PATH=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# --- Meta: WhatsApp Business / Instagram / Messenger (optional) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=
MESSENGER_PAGE_TOKEN=
MESSENGER_PAGE_USERNAME=
